/* ============================================================
   现代深色主题
   取值不写死：双花括号里的令牌名由 app/core/theme.py 提供，加载时替换
   （见 utils.load_style_sheet）。改配色、字号、圆角只改那一处。
   新增样式一律引用已有令牌，不要再写十六进制 —— 同一层级的近似色各自写死，
   想整体调深一档就得改十几处（历史上有过 #3a3f4e/#3a3f4d 只差 1 的两套边框色）。
   表面由深到浅：bg_sunken / bg_base / bg_panel / bg_raised / bg_control /
   bg_control_2 / bg_hover；描边 border_subtle → border → border_strong →
   border_hover；文字 text → text_2 → text_3 → text_faint → text_disabled。
   控件盒模型：总高 = 内容高 + 上下 padding 6 + 边框 2。
   主窗口 h_ctrl 18 → 32；弹窗 h_ctrl_dialog 22 → 36。
   标注对话框是独立子主题（底色 bg_deep），有意比全局更暗。
   ============================================================ */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", sans-serif;
    font-size: {{font_base}};
    color: {{text}};
    outline: none;
}

QWidget {
    background-color: {{bg_base}};
    color: {{text}};
}

/* ---------------- 主窗口 / 对话框 ---------------- */
QMainWindow, QDialog {
    background-color: {{bg_base}};
}

/* ---------------- 顶部标题栏 ---------------- */
QFrame#headerBar {
    background-color: {{bg_raised}};
    border-bottom: 1px solid {{border_subtle}};
}

QLabel#appTitle {
    font-size: {{font_2xl}};
    font-weight: bold;
    color: {{text_strong}};
}

/* ---------------- 侧边栏 ---------------- */
QFrame#sidebarPanel {
    background-color: {{bg_panel}};
    border-right: 1px solid {{border_subtle}};
}

QLabel#sidebarTitle {
    color: {{text_faint}};
    font-size: {{font_sm}};
    font-weight: 700;
    letter-spacing: 2px;
    padding: 2px 0 4px 2px;
}

/* 侧栏「+」ghost 小按钮（24x24, 覆盖全局 padding 避免文字被挤出） */
QPushButton#add_project_btn {
    background: transparent;
    border: 1px solid {{border}};
    border-radius: {{r_md}};
    padding: 0;
    min-height: 0;
    color: {{text_3}};
    font-size: {{font_xl}};
}
QPushButton#add_project_btn:hover {
    color: {{text}};
    border-color: {{border_hover}};
    background-color: {{bg_control}};
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background-color: {{bg_control}};
    border: 1px solid {{border}};
    border-radius: {{r_md}};
    padding: {{pad_btn}};
    color: {{text}};
    min-height: {{h_ctrl}};
}

/* 弹窗内按钮统一 36 高（内容 22 + padding 12 + 边框 2），与同排输入框同高 */
QDialog QPushButton {
    min-height: {{h_ctrl_dialog}};
}

QPushButton:hover {
    background-color: {{bg_hover}};
    border-color: {{border_hover}};
}

QPushButton:pressed {
    background-color: {{bg_pressed}};
}

QPushButton:disabled {
    background-color: {{bg_panel}};
    border-color: {{border_subtle}};
    color: {{text_disabled}};
}

/* #msgBtn 是 ID 选择器，特异性高于属性选择器，弹窗按钮要带 ID 才盖得住 */
QPushButton[class~="primary"],
QPushButton#msgBtn[class~="primary"] {
    background-color: {{accent}};
    border: 1px solid {{accent}};
    color: {{text_strong}};
    font-weight: bold;
}

QPushButton[class~="primary"]:hover,
QPushButton#msgBtn[class~="primary"]:hover {
    background-color: {{accent_hover}};
    border-color: {{accent_hover}};
}

QPushButton[class~="primary"]:pressed,
QPushButton#msgBtn[class~="primary"]:pressed {
    background-color: {{accent_pressed}};
}

QPushButton[class~="primary"]:disabled,
QPushButton#msgBtn[class~="primary"]:disabled {
    background-color: {{accent_dim}};
    border-color: {{accent_dim}};
    color: {{text_3}};
}

QPushButton[class~="danger"] {
    background-color: {{danger_bg}};
    border: 1px solid {{danger_border}};
    color: {{danger_text}};
}

QPushButton[class~="danger"]:hover {
    background-color: {{danger_bg_hover}};
    border-color: {{danger_border_hover}};
}
/* 属性选择器与 :disabled 特异性相同, 不补这条时"删除"禁用后仍是危险色 */
QPushButton[class~="danger"]:disabled {
    background-color: {{bg_panel}};
    border-color: {{border_subtle}};
    color: {{text_disabled}};
}

QPushButton[class~="ghost"] {
    background-color: transparent;
    border: 1px solid {{border_strong}};
    color: {{text_2}};
}

QPushButton[class~="ghost"]:hover {
    background-color: {{bg_control}};
    border-color: {{border_hover}};
}

/* 工具栏按钮 */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: {{r_md}};
    padding: 5px;
    color: {{text_2}};
}

QToolButton:hover {
    background-color: {{bg_hover}};
}

QToolButton:checked {
    background-color: {{accent_dim}};
}

/* ---------------- 输入框 ---------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: {{bg_base}};
    border: 1px solid {{border}};
    border-radius: {{r_md}};
    padding: {{pad_field}};
    min-height: {{h_ctrl}};
    selection-background-color: {{accent}};
    selection-color: {{text_strong}};
}

/* 弹窗内输入类控件统一 36 高（内容 22 + padding 12 + 边框 2），与按钮同高；
   min-height 只算内容区，主界面不受影响 */
QDialog QLineEdit, QDialog QComboBox, QDialog QSpinBox, QDialog QDoubleSpinBox {
    min-height: {{h_ctrl_dialog}};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: {{accent}};
}

/* 下拉框要单列: 样式表一旦接管了 QComboBox 的颜色, disabled 的自动灰化就失效,
   不写这条置灰与可用的下拉长得完全一样(实测同为 #8b8f97) */
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled {
    background-color: {{bg_panel}};
    color: {{text_disabled}};
}
/* 下拉的文字其实画在内部那个只读 lineEdit 上(见 combo_utils.style_combo),
   只给 QComboBox 上色的话它只被"捎带"着暗一点, 与输入框的置灰色对不齐 */
QComboBox:disabled QLineEdit {
    color: {{text_disabled}};
}

/* ---------------- 下拉框 ---------------- */
QComboBox {
    background-color: {{bg_base}};
    border: 1px solid {{border}};
    border-radius: {{r_md}};
    padding: {{pad_field}};
    min-height: {{h_ctrl}};
}

QComboBox:hover {
    border-color: {{border_hover}};
}

QComboBox:focus {
    border-color: {{accent}};
}

/* 语言下拉要装九种语言名里最长的那个(Tiếng Việt), 左右内边距比通用下拉紧一点 */
#language_comboBox {
    padding: 6px 6px;
}

/* 箭头区默认占 24px, 而箭头图只用 11px + 8px 右边距, 富余的宽度让给文字区:
   控件因此能从 134 收到 130, 最长那条(Tiếng Việt)右边还剩 5px.
   只写 ::drop-down, 别给 ::down-arrow 加 id 规则 —— 不同选择器的规则不合并,
   那样会让全局的箭头图片整条失效. */
#language_comboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* Qt 不认 CSS 的 border 三角写法(会画成实心方块), 箭头只能用图片 */
QComboBox::down-arrow {
    image: url({{RES_DIR}}/arrow_down.svg);
    width: 11px;
    height: 7px;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: {{bg_control}};
    border: 1px solid {{border_strong}};
    border-radius: {{r_md}};
    /* 贴合下拉框的一边不画圆角, 由 popupOpen 抹平控件侧后拼成一整块 */
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    selection-background-color: {{accent_dim}};
    selection-color: {{text_strong}};
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    border-radius: {{r_sm}};
    padding-left: 8px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: {{accent_dim}};
}

/* 展开时抹平下拉框的下圆角, 与弹层拼成一整块(标记由 widgets/popup_flat.py 打上).
   选择器要覆盖各处单独定义过 border-radius 的下拉框 */
QComboBox[popupOpen="true"],
QDialog#MoveTargetDialog QComboBox[popupOpen="true"] {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QHeaderView::section {
    background-color: {{bg_raised}};
    border: none;
    padding: 6px;
    color: {{text_3}};
}

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: {{border_strong}};
    border-radius: {{r_sm}};
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: {{border_hover}};
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: {{border_strong}};
    border-radius: {{r_sm}};
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: {{border_hover}};
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------------- 进度条 ---------------- */
QProgressBar {
    background-color: {{bg_sunken}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
    text-align: center;
    color: {{text_strong}};
    font-size: {{font_md}};
    font-weight: 600;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 {{accent}}, stop:1 {{accent_soft}});
    border-radius: {{r_lg}};
}

/* ---------------- 剩余时间 / 显存（训练时显示） ---------------- */
QTimeEdit#time_count_edit {
    background-color: {{bg_sunken}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_md}};
    color: {{text_strong}};
    font-size: {{font_md}};
    font-weight: 600;
    padding: 2px 8px;
    min-height: 18px;
    selection-background-color: {{accent}};
}

QTimeEdit#time_count_edit:focus {
    border-color: {{accent}};
}

QLabel#time_count_label, QLabel#gpu_memory_label {
    color: {{text_3}};
    font-size: {{font_md}};
    background: transparent;
    padding: 0 2px;
}

/* ---------------- 标签 ---------------- */
QLabel {
    background: transparent;
}

/* ---------------- 选项卡 ---------------- */
QTabWidget::pane {
    border: none;
    background-color: {{bg_sunken}};
}

QTabBar::tab {
    background: transparent;
    color: {{text_3}};
    border: none;
    padding: 8px 22px;
    font-size: {{font_lg}};
    font-weight: bold;
}

QTabBar::tab:selected {
    color: {{text_strong}};
    border-bottom: 2px solid {{accent}};
}

QTabBar::tab:hover:!selected {
    color: {{text_2}};
}

/* ---------------- 分组框 ---------------- */
QGroupBox {
    background-color: {{bg_panel}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: {{text_2}};
}

/* ---------------- 列表 ---------------- */
QListWidget {
    background-color: {{bg_base}};
    border: 1px solid {{border}};
    border-radius: {{r_lg}};
    outline: none;
}

QListWidget::item {
    padding: 2px 4px;
    border-radius: {{r_md}};
    margin: 1px 3px;
}

QListWidget::item:hover {
    background-color: {{bg_control}};
}

QListWidget::item:selected {
    background-color: {{accent_dim}};
    color: {{text_strong}};
}

/* ---------------- 表格 ---------------- */
QTableWidget, QTableView {
    background-color: {{bg_base}};
    border: 1px solid {{border}};
    border-radius: {{r_lg}};
    gridline-color: {{border_subtle}};
    alternate-background-color: {{bg_panel}};
}

QTableWidget::item, QTableView::item {
    padding: 5px;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: {{accent_dim}};
    color: {{text_strong}};
}

QTableCornerButton::section {
    background-color: {{bg_raised}};
    border: none;
}

/* ---------------- 单选 / 复选 ---------------- */
QRadioButton, QCheckBox {
    spacing: 12px;
    color: {{text}};
    /* Qt 在 QCheckBox/QFormLayout 等场景会把 ::indicator 的 background-color
       当作 widget 的 background 涂到整行（见 test_dialog 复现），
       显式置 transparent 让背景跟随父 widget */
    background-color: transparent;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{border_hover}};
    border-radius: {{r_sm}};
    background-color: {{bg_base}};
}
QCheckBox::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
    /* 勾形是预渲染 PNG(28px 给 14px, 与 radio 同样的 2 倍图):
       QSS 画不出勾, 直接给图在分数缩放下比缩放矢量更可控 */
    image: url({{RES_DIR}}/check_mark.png);
}
QCheckBox::indicator:hover {
    border-color: {{accent}};
}

/* 单选指示器用预渲染 PNG(QPainter 反锯齿正圆):
   QSS border-radius 在小尺寸+分数缩放(125%/150%)下会画成圆角方块 */
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: none;
    background-color: transparent;
    image: url({{RES_DIR}}/radio_off.png);
}
QRadioButton::indicator:hover {
    image: url({{RES_DIR}}/radio_off_hover.png);
}
QRadioButton::indicator:checked {
    image: url({{RES_DIR}}/radio_on.png);
}

/* ---------------- 分割条 ---------------- */
QSplitter::handle {
    background-color: {{border_subtle}};
}

QSplitter::handle:horizontal {
    width: 1px;
}

/* ---------------- 提示气泡 ---------------- */
QToolTip {
    background-color: {{bg_hover}};
    color: {{text}};
    border: 1px solid {{border_hover}};
    border-radius: {{r_sm}};
    padding: 4px 8px;
    font-size: {{font_md}};
}

/* ---------------- 滑条 ---------------- */
QSlider::groove:horizontal {
    height: 6px;
    background: {{border_strong}};
    border-radius: {{r_sm}};
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: {{r_lg}};
    background: {{accent}};
}
QSlider::handle:horizontal:hover { background: {{accent_hover}}; }

QSlider::sub-page:horizontal {
    background: {{accent}};
    border-radius: {{r_sm}};
}

/* ---------------- 键盘焦点 ---------------- */
/* 顶部 * 关掉了 outline，Tab 必须补回。
   按钮不能用 outline：Qt 把它画在 SE_PushButtonFocusRect 上，
   那个矩形是内容区（文字一圈），看起来像文字被框住而不是按钮被选中；
   改用 border-color，按钮本来就有 1px 边框，只换颜色不会让文字位移。
   列表/滑条用 outline：focus rect 覆盖整个控件。
   表格不用 outline：Qt 会把 focus rect 画在 current cell 周围，
   看起来像单元格外多一圈蓝框；用 selection 颜色变化已足够表达焦点。 */
QCheckBox:focus, QRadioButton:focus {
    /* 单选/复选不能用 outline: Qt 画在文字一圈, 点击后也会带框;
       焦点改由指示器边框变蓝表达, 键盘导航仍可见 */
    outline: none;
}
QCheckBox:focus::indicator {
    border-color: {{accent}};
}
QListWidget:focus, QTreeWidget:focus,
QSlider:focus {
    outline: 2px solid {{accent}};
    outline-offset: 1px;
}
QTableWidget:focus, QTableView:focus {
    outline: none;
    selection-background-color: {{accent_dim}};
}
QTableWidget::item:focus, QTableView::item:focus {
    border: none;
    outline: none;
}
/* 点完按钮鼠标通常还在上面，hover 特异性更高会盖掉 :focus，必须并列写 */
QPushButton:focus, QPushButton:hover:focus {
    border-color: {{accent}};
}
/* 工具栏按钮常态无边框，用背景提示焦点，避免加边框导致图标位移 */
QToolButton:focus, QToolButton:hover:focus {
    background-color: {{bg_hover}};
}
/* Primary/Danger 背景本身接近主色，边框换成对比色才看得出 */
QPushButton[class~="primary"]:focus,
QPushButton[class~="primary"]:hover:focus,
QPushButton#msgBtn[class~="primary"]:focus,
QPushButton#msgBtn[class~="primary"]:hover:focus {
    border-color: {{text_strong}};
}
QPushButton[class~="danger"]:focus,
QPushButton[class~="danger"]:hover:focus {
    border-color: {{danger_text}};
}

/* ---------------- 项目侧边栏（卡片式，行内容由 delegate 手绘） ---------------- */
QWidget#projectSidebar {
    background: transparent;
}
QFrame#projectCard {
    background-color: {{bg_control}};
    border: 1px solid {{border_strong}};
    border-radius: {{r_xl}};
}
/* 卡头在 Python 侧画悬停底色, 这里只提亮描边 */
QFrame#projectCard:hover {
    border-color: {{border_hover}};
}
/* 侧栏数据集列表: 背景与卡片同色(全局 QListWidget 是深底 bg_base);
   item 的背景/边距全部归零, hover/选中态由 DatasetRowDelegate 手绘, 避免叠加 */
QListWidget#datasetList {
    background-color: {{bg_control}};
    border: none;
    outline: none;
}
QListWidget#datasetList::item {
    background: transparent;
    padding: 0;
    margin: 0;
    border-radius: 0;
}
QListWidget#datasetList::item:hover,
QListWidget#datasetList::item:selected {
    background: transparent;
}
QFrame#sidebarStatsLine {
    background-color: {{bg_raised}};
    border: none;
}
QLabel#sidebarStats {
    color: {{text_disabled}};
    font-size: {{font_sm}};
    background: transparent;
}

/* ---------------- 数据集对话框（ui/add_dataset） ---------------- */
QDialog#AddDatasets {
    background-color: {{bg_panel}};
}
QPushButton#done_btn {
    background-color: {{accent}};
    color: {{text_strong}};
    border: none;
    border-radius: {{r_md}};
    padding: 8px 20px;
    font-size: {{font_base}};
}
QPushButton#done_btn:hover {
    background-color: {{accent_hover}};
}
QPushButton#done_btn:pressed {
    background-color: {{accent_pressed}};
}

/* ================ 标注对话框（AnnotationDialog） ================
 * 原 ANNOTATION_QSS（app/annotation_dialog.py 内嵌字符串）迁移至此。
 * 全部用 #AnnotationDialog 作用域限定：只作用于标注对话框及其后代，
 * 不污染主窗口 / 其他弹窗（对象名在 AnnotationDialog.__init__ 设置）。 */
#AnnotationDialog {
    background-color: {{bg_deep}};
    color: {{text}};
}
#AnnotationDialog QWidget {
    background-color: {{bg_deep}};
    color: {{text}};
    font-family: "Microsoft YaHei", "Noto Sans CJK SC";
    font-size: {{font_base}};
}
#AnnotationDialog QLabel {
    background: transparent;
    color: {{text}};
}
#AnnotationDialog QLineEdit {
    background-color: {{bg_deep_2}};
    border: 1px solid {{border_strong}};
    border-radius: {{r_md}};
    padding: {{pad_field}};
    color: {{text}};
    selection-background-color: {{accent_dim}};
}
/* 工具栏输入框高度锁成和按钮一致: QSS 尺寸按内容盒算(22+padding12+边框2=36,
   与 QPushButton 的 min-height:22 同一套盒模型), 代码里不再 setFixedSize 高度 */
#AnnotationDialog QLineEdit#min_ange_lineEdit,
#AnnotationDialog QLineEdit#max_ange_lineEdit,
#AnnotationDialog QLineEdit#blend_strength_lineEdit {
    min-height: 22px;
    max-height: 22px;
}
/* 填充值 RGB 三框: 锁成 36x36 正方形(高 22+6*2+2, 宽 26+4*2+2);
   横向 padding 不能用 10px, 否则内容区太窄 "255" 三位数显示不下 */
#AnnotationDialog QLineEdit#fill_r_lineEdit,
#AnnotationDialog QLineEdit#fill_g_lineEdit,
#AnnotationDialog QLineEdit#fill_b_lineEdit {
    min-height: 22px;
    max-height: 22px;
    min-width: 26px;
    max-width: 26px;
    padding: 6px 4px;
}
#AnnotationDialog QPushButton {
    background-color: {{bg_control_2}};
    border: 1px solid {{border_strong}};
    border-radius: {{r_md}};
    padding: {{pad_btn}};
    color: {{text_2}};
}
#AnnotationDialog QPushButton:hover {
    background-color: {{bg_hover}};
    border-color: {{accent}};
}
#AnnotationDialog QPushButton:pressed {
    background-color: {{bg_pressed}};
}
#AnnotationDialog QPushButton[drawActive="true"] {
    background-color: {{accent_dim}};
    color: {{text_strong}};
    border: 1px solid {{accent}};
}
/* "标注信息"标题旁的小按钮: 比工具条按钮矮一档, 免得把标题行撑高 */
#AnnotationDialog QPushButton#px_scale_btn {
    min-height: 0;
    padding: 2px 8px;
    border-radius: {{r_sm}};
    font-size: {{font_md}};
    color: {{text_2}};
}
#AnnotationDialog QPushButton#px_scale_btn[pxScaleSet="true"] {
    background-color: {{accent_dim}};
    border-color: {{accent}};
    color: {{text_strong}};
}
/* ---------- 标注参数弹层 ----------
   特异性必须高于上面的 `#AnnotationDialog QWidget`(底色 #13151a), 否则浮层和画布同色,
   看起来就是一块没有边框的空白. */
#AnnotationDialog QFrame#paramsPanel {
    background-color: {{bg_panel}};
    border: 1px solid {{border_strong}};
    border-radius: {{r_xl}};
}
#AnnotationDialog QLabel#params_title {
    color: {{text_3}};
    font-size: {{font_md}};
}
#AnnotationDialog QFrame#paramsPanel QLabel {
    color: {{text_2}};
}
#AnnotationDialog QFrame#params_sep {
    background-color: {{border_subtle}};
    border: none;
}
/* 弹层里的输入框比工具条矮一档(工具条 36, 这里 16+6*2+2=30) */
#AnnotationDialog QFrame#paramsPanel QLineEdit {
    min-height: 16px;
    max-height: 16px;
}
#AnnotationDialog QPushButton#fill_color_btn {
    padding: 0;
    border: 1px solid {{border_hover}};
    border-radius: {{r_md}};
}
/* 与同行色块同尺寸(28x28 = 内容盒 26 + 边框 2). 尺寸必须写进按钮自身的 QSS:
   全局 QPushButton 的 min-height 内边距会架空 setFixedSize 的下限 */
#AnnotationDialog QPushButton#custom_color_btn {
    padding: 0;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    border: 1px solid {{border_hover}};
    border-radius: {{r_md}};
    background-color: {{bg_control_2}};
}
#AnnotationDialog QPushButton#custom_color_btn:hover {
    border-color: {{accent}};
    background-color: {{bg_hover}};
}
/* 滑块会被上面的 `#AnnotationDialog QWidget`(底色 bg_deep) 刷成比弹层底
   (bg_panel) 更黑的一条, 这里只保留中间的 groove */
#AnnotationDialog QFrame#paramsPanel QSlider {
    background: transparent;
}
#AnnotationDialog QPushButton#reset_params_btn,
#AnnotationDialog QPushButton#close_params_btn {
    min-width: 72px;
}
#AnnotationDialog QScrollArea {
    background-color: {{bg_deep_2}};
    border: 1px solid {{border_strong}};
    border-radius: {{r_md}};
}
#AnnotationDialog QScrollArea > QWidget > QWidget {
    background-color: {{bg_deep_2}};
}
#AnnotationDialog QScrollBar:vertical {
    background: {{bg_deep_2}};
    width: 8px;
    border: none;
}
#AnnotationDialog QScrollBar::handle:vertical {
    background: {{border_strong}};
    border-radius: {{r_sm}};
    min-height: 24px;
}
#AnnotationDialog QScrollBar::handle:vertical:hover { background: {{accent}}; }
#AnnotationDialog QScrollBar::add-line:vertical,
#AnnotationDialog QScrollBar::sub-line:vertical { height: 0; }

/* ---------------- 菜单 ---------------- */
/* 这段必须排在 `#AnnotationDialog QWidget`(见上) 之后: 两者的特异性都是 1 个 id + 1 个类型,
   平手时按出现顺序决胜, 排在前面的话菜单底色会被那条刷掉 */
QMenu,
#AnnotationDialog QMenu {
    background-color: {{bg_panel}};
    border: 1px solid {{border_strong}};
    border-radius: {{r_md}};
    padding: 5px;
}

QMenu::item,
#AnnotationDialog QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: {{r_sm}};
}

QMenu::item:selected,
#AnnotationDialog QMenu::item:selected {
    background-color: {{accent_dim}};
    color: {{text_strong}};
}

/* QSS 下禁用项默认沿用正常文字色, 不设就分不出能不能点 */
QMenu::item:disabled,
#AnnotationDialog QMenu::item:disabled {
    color: {{text_faint}};
}

QMenu::separator,
#AnnotationDialog QMenu::separator {
    height: 1px;
    background: {{border_subtle}};
    margin: 4px 8px;
}

/* ================ 训练对话框 ================ */
QDialog#TrainDialog,
QDialog#TrainQueueDialog { background-color: {{bg_panel}}; }

/* 队列面板:状态徽标跟随队列状态变色 */
QDialog#TrainQueueDialog QLabel#queue_badge { color: {{text_3}}; }

/* 面板内控件比对话框底亮一档(bg_panel → bg_control_2)，聚焦只换边框色不改变盒子尺寸 */
QDialog#TrainDialog QLineEdit,
QDialog#TrainDialog QComboBox {
    background-color: {{bg_control_2}};
    border: 1px solid {{border}};
}
QDialog#TrainDialog QLineEdit:hover,
QDialog#TrainDialog QComboBox:hover { border-color: {{border_hover}}; }
QDialog#TrainDialog QLineEdit:focus,
QDialog#TrainDialog QComboBox:focus { border-color: {{accent}}; }
QDialog#TrainDialog QComboBox QAbstractItemView {
    background-color: {{bg_control}};
    border-color: {{border_strong}};
}
QDialog#TrainDialog QPushButton#select_output_path_btn { min-width: 90px; }
QDialog#TrainDialog QPushButton#start_train {
    background-color: {{accent}};
    color: {{text_strong}};
    font-weight: 500;
    min-width: 120px;
    padding: 6px 22px;
}
QDialog#TrainDialog QPushButton#start_train:hover { background-color: {{accent_hover}}; }
QDialog#TrainDialog QPushButton#start_train:pressed { background-color: {{accent_pressed}}; }
QDialog#TrainDialog QPushButton#start_train:disabled {
    background-color: {{bg_control_2}};
    color: {{text_faint}};
}

/* ---------------- 测试参数对话框 ---------------- */
QDialog#TestDialog { background-color: {{bg_panel}}; }
QDialog#TestDialog QComboBox,
QDialog#TestDialog QLineEdit {
    background-color: {{bg_control_2}};
    border: 1px solid {{border}};
}
QDialog#TestDialog QComboBox:focus,
QDialog#TestDialog QLineEdit:focus { border-color: {{accent}}; }
QDialog#TestDialog QPushButton#start_test_btn {
    background-color: {{accent}}; color: {{text_strong}}; font-weight: 500;
    min-width: 110px; padding: 6px 22px;
}
QDialog#TestDialog QPushButton#start_test_btn:hover {
    background-color: {{accent_hover}};
}
QDialog#TestDialog QPushButton#start_test_btn:pressed {
    background-color: {{accent_pressed}};
}

/* 顶部模型信息卡 */
QDialog#TestDialog QFrame#model_card {
    background-color: {{bg_base}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
}
QDialog#TestDialog QLabel[class~="modelName"] {
    color: {{text_strong}};
    font-size: {{font_xl}};
    font-weight: 600;
}
QDialog#TestDialog QLabel[class~="modelMeta"] {
    color: {{text_3}};
    font-size: {{font_md}};
}

/* ---------------- 通用弹窗组件（训练 / 测试对话框共用） ----------------
   一律按 class 匹配，不绑具体对话框 ID，两个弹窗改版不用各写一份 */
/* 参数行的原生 QWidget 包裹容器必须透明：全局 QWidget 底色 bg_base
   比弹窗底色 bg_panel 暗一档，不透明会整行拖出“黑条” */
QDialog#TrainDialog QWidget#section_data_wrap,
QDialog#TrainDialog QWidget#section_hyper_wrap,
QDialog#TrainDialog QWidget#early_wrap,
QDialog#TrainDialog QWidget#lr_wrap,
QDialog#TrainDialog QWidget#img_wrap,
QDialog#TrainDialog QWidget#grad_wrap,
QDialog#TrainDialog QWidget#section_out_wrap,
QDialog#TrainDialog QWidget#section_aug_wrap,
QDialog#TrainDialog QWidget#aug_body,
QDialog#TestDialog QWidget#conf_wrap,
QDialog#TestDialog QWidget#iou_wrap,
QDialog#TestDialog QWidget#out_wrap {
    background-color: transparent;
}
QLabel[class~="dialogTitle"] {
    color: {{text_strong}};
    font-size: {{font_xl}};
    font-weight: bold;
}
/* 分组标题：比字段名的 13px 大两号，撑起「组 → 字段」的层次 */
QLabel[class~="dialogSectionTitle"] {
    color: {{accent_text}};
    font-size: {{font_xl}};
    font-weight: 600;
    margin-top: 2px;
}
QLabel[class~="taskBadge"] {
    background-color: {{accent_dim}};
    color: {{accent_text}};
    border-radius: {{r_sm}};
    padding: 2px 8px;
    font-size: {{font_md}};
    font-weight: 600;
}
/* 参数说明：比 tooltip 更容易被看到 */
QLabel[class~="fieldNote"] {
    color: {{text_3}};
    font-size: {{font_md}};
}

/* 底部概要条 */
QFrame#summary_bar {
    background-color: {{bg_base}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
}
QLabel[class~="summaryIcon"] {
    color: {{accent}};
    font-size: {{font_base}};
    font-weight: bold;
}
QLabel[class~="summaryText"] {
    color: {{text_2}};
    font-size: {{font_base}};
}
/* 分组标题后 / 底栏上方的细分隔线 */
QFrame[class~="dialogSectionLine"],
QFrame#button_line {
    background-color: {{border_subtle}};
    border: none;
    max-height: 1px;
}
QFrame#button_line { margin-top: 2px; }
QLabel#dialogConfirmPrompt { font-size: {{font_xl}}; }

/* 数据增强勾选区：只剩折叠箭头与启用计数徽标.
   勾选项本身是 CheckChip 自绘的, 不经过 QSS */
QToolButton[class~="augToggle"] {
    background-color: transparent;
    border: none;
    padding: 0;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    color: {{text_2}};
}
QToolButton[class~="augToggle"]:hover { color: {{accent_text}}; }
QLabel[class~="augCount"] {
    background-color: {{bg_base}};
    color: {{text_3}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_sm}};
    padding: 1px 9px;
    font-size: {{font_md}};
}
QLabel[class~="augCount"][on="true"] {
    background-color: {{accent_dim}};
    color: {{accent_text}};
    border-color: {{accent_dim}};
}
QLabel[class~="augCount"][on="true"]:disabled {
    background-color: {{bg_base}};
    color: {{text_3}};
    border-color: {{border_subtle}};
}
QLabel[class~="augGroupTitle"] {
    color: {{text_2}};
    font-size: {{font_md}};
    font-weight: 600;
}
QLabel[class~="augGroupTip"] {
    color: {{text_3}};
    font-size: {{font_md}};
}
QLabel[class~="augGroupTitle"]:disabled,
QLabel[class~="augGroupTip"]:disabled { color: {{text_3}}; }

/* ---------------- 模型管理对话框 ---------------- */
QDialog#ModelDialog { background-color: {{bg_panel}}; }
QDialog#ModelDialog QTableWidget {
    background-color: {{bg_base}};
    alternate-background-color: {{bg_raised}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
    gridline-color: {{border_subtle}};
    color: {{text}};
    font-size: {{font_md}};
}
QDialog#ModelDialog QTableWidget::item { padding: 6px 8px; }
QDialog#ModelDialog QTableWidget::item:hover {
    background-color: {{bg_hover}};
}
QDialog#ModelDialog QTableWidget::item:selected {
    background-color: {{accent_dim}};
    color: {{text_strong}};
}
QDialog#ModelDialog QHeaderView::section {
    background-color: {{bg_control}};
    color: {{text_2}};
    border: none;
    border-right: 1px solid {{border_subtle}};
    border-bottom: 1px solid {{border_subtle}};
    padding: 8px;
    font-size: {{font_md}};
    font-weight: 600;
}
QDialog#ModelDialog QPushButton {
    background-color: {{bg_control_2}}; color: {{text}}; border: 1px solid {{border}};
    border-radius: {{r_md}}; padding: 4px 12px; font-size: {{font_md}};
}
QDialog#ModelDialog QPushButton:hover { background-color: {{bg_hover}}; }
QDialog#ModelDialog QPushButton:disabled {
    background-color: {{bg_control}}; color: {{text_disabled}};
}
QDialog#ModelDialog QScrollBar:vertical {
    background: {{bg_base}}; width: 10px; border: none;
}
QDialog#ModelDialog QScrollBar::handle:vertical {
    background: {{border_strong}}; border-radius: {{r_md}}; min-height: 30px;
}
QDialog#ModelDialog QScrollBar::add-line:vertical,
QDialog#ModelDialog QScrollBar::sub-line:vertical { height: 0; }

/* ---------------- 测试结果对话框 ---------------- */
QDialog#TestResultDialog { background-color: {{bg_base}}; }
QFrame#card_img_total, QFrame#card_img_ok, QFrame#card_img_fn,
QFrame#card_img_fp, QFrame#card_tp, QFrame#card_fn, QFrame#card_fp,
QFrame#card_precision {
    background-color: {{bg_panel}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
}
QDialog#TestResultDialog QLabel[class~="dimTag"] {
    color: {{accent}};
    font-size: {{font_md}};
    font-weight: 600;
}
QDialog#TestResultDialog QLabel[class~="dimNote"] {
    color: {{text_3}};
    font-size: {{font_md}};
}
QDialog#TestResultDialog QLabel[class~="cardValue"] {
    color: {{text_strong}};
    font-size: {{font_3xl}};
    font-weight: 600;
}
QDialog#TestResultDialog QLabel[class~="cardLabel"] {
    color: {{text_3}};
    font-size: {{font_md}};
}
QDialog#TestResultDialog QLabel[class~="cardRate"] {
    font-size: {{font_md}};
}
QDialog#TestResultDialog QLabel#conclusion_label {
    color: {{text_2}};
    font-size: {{font_base}};
    background-color: {{bg_panel}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
    padding: 12px 14px;
}
QDialog#TestResultDialog QTableWidget {
    background-color: {{bg_base}};
    alternate-background-color: {{bg_raised}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
    gridline-color: {{border_subtle}};
    color: {{text}};
    font-size: {{font_md}};
}
QDialog#TestResultDialog QHeaderView::section {
    background-color: {{bg_control}};
    color: {{text_2}};
    border: none;
    border-right: 1px solid {{border_subtle}};
    border-bottom: 1px solid {{border_subtle}};
    padding: 6px 8px;
    font-size: {{font_md}};
}

/* ---------------- 日志对话框 ---------------- */
QDialog#LogDialog { background-color: {{bg_panel}}; }
QDialog#LogDialog QTextEdit {
    background-color: {{bg_sunken}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
    font-family: "Consolas", "Microsoft YaHei UI", monospace;
    font-size: {{font_md}};
    padding: 8px;
    color: {{text}};
    selection-background-color: {{accent}};
    selection-color: {{text_strong}};
}
QDialog#LogDialog QPushButton#clr_log_btn {
    background-color: {{bg_control_2}}; color: {{text}}; border: 1px solid {{border}};
    border-radius: {{r_md}}; padding: 6px 18px; font-size: {{font_base}};
}
QDialog#LogDialog QPushButton#clr_log_btn:hover { background-color: {{bg_hover}}; }

/* ---------------- 消息框 ---------------- */
QMessageBox { background-color: {{bg_panel}}; }
QMessageBox QLabel {
    color: {{text}}; font-size: {{font_base}}; min-width: 280px;
    qproperty-alignment: AlignCenter;
}
QMessageBox QPushButton {
    background-color: {{bg_control_2}}; color: {{text}}; border: 1px solid {{border}};
    border-radius: {{r_md}}; padding: 6px 18px; font-size: {{font_base}};
}
QMessageBox QPushButton:hover { background-color: {{bg_hover}}; }
QMessageBox QPushButton:default {
    background-color: {{accent}}; color: {{text_strong}}; font-weight: 600;
}
QMessageBox QPushButton:default:hover { background-color: {{accent_hover}}; }

/* ---------------- 移动目标数据集对话框 ---------------- */
QDialog#MoveTargetDialog { background-color: {{bg_panel}}; }
QDialog#MoveTargetDialog QLabel { color: {{text}}; font-size: {{font_base}}; }
QDialog#MoveTargetDialog QComboBox {
    background-color: {{bg_control_2}}; color: {{text}}; border: 1px solid {{border}};
    border-radius: {{r_md}}; padding: 6px 10px; font-size: {{font_base}};
}
QDialog#MoveTargetDialog QComboBox::drop-down { border: none; }
QDialog#MoveTargetDialog QPushButton {
    background-color: {{bg_control_2}}; color: {{text}}; border: 1px solid {{border}};
    border-radius: {{r_md}}; padding: 6px 18px; font-size: {{font_base}};
}
QDialog#MoveTargetDialog QPushButton:hover { background-color: {{bg_hover}}; }

/* ---------------- 首页顶部工具栏分组 ---------------- */
QFrame#headerSeparator {
    background: transparent;
    border: none;
    border-right: 1px solid {{border_subtle}};
    margin: 6px 4px;
    width: 1px;
}

/* 溢出菜单: 收窄到装不下时, 顶栏尾部的入口按钮藏进这里 */
QPushButton#headerMoreBtn {
    padding: 6px 10px;
}
QPushButton#headerMoreBtn::menu-indicator { image: none; width: 0px; }

/* 训练/测试/结果框内容区可滚动: 框与视口都透出对话框底色, 只留右侧滚动条 */
QDialog#TrainDialog QScrollArea,
QDialog#TestDialog QScrollArea,
QDialog#TestResultDialog QScrollArea {
    background: transparent;
    border: none;
}
QDialog#TrainDialog QScrollArea > QWidget > QWidget,
QDialog#TestDialog QScrollArea > QWidget > QWidget,
QDialog#TestResultDialog QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* 标签筛选按钮与它弹出的平铺面板都自绘(app/widgets/label_filter_popup.py),
   走不上 QSS, 这里不再给它们配色 */

/* ---------------- 数据集行内迷你进度条（导入/标签合并时显示） ---------------- */
QProgressBar#miniProgressBar {
    background-color: rgba({{accent_rgb}},0.25);
    border: none;
    border-radius: {{r_sm}};
    color: {{text_strong}};
    font-size: {{font_xs}};
}
QProgressBar#miniProgressBar::chunk {
    background-color: {{accent}};
    border-radius: {{r_sm}};
}

/* ---------------- 多选下拉框只读 lineEdit（统计/训练界面） ---------------- */
/* 多选下拉: 收起态是一排自绘标签, 内边距收窄给标签让位 */
QComboBox[multiCombo="true"] {
    padding: 4px 8px;
}

QComboBox[multiCombo="true"] QLineEdit#multiComboLineEdit,
QComboBox[multiCombo="true"] QLineEdit#multiComboLineEdit:focus {
    background: transparent;
    border: none;
    padding: 0;
}

/* ---------------- 训练对话框开始按钮(主操作) ---------------- */
QPushButton#start_train {
    background-color: {{accent}};
    border: 1px solid {{accent}};
    border-radius: {{r_md}};
    color: {{text_strong}};
    font-weight: bold;
    padding: 6px 22px;
}
QPushButton#start_train:hover {
    background-color: {{accent_hover}};
    border-color: {{accent_hover}};
}
QPushButton#start_train:pressed {
    background-color: {{accent_pressed}};
}
QPushButton#start_train:disabled {
    background-color: {{accent_dim}};
    border-color: {{accent_dim}};
    color: {{text_3}};
}

/* ---------------- 停止训练按钮(红色) ---------------- */
QPushButton#stop_train_btn {
    background-color: {{danger_solid}};
    color: {{text_strong}};
    border: none;
    border-radius: {{r_md}};
    padding: 4px 12px;
    font-size: {{font_base}};
}
QPushButton#stop_train_btn:hover {
    background-color: {{danger_solid_hover}};
}

/* ---------------- 标注对话框标签列表 ---------------- */
QLabel#show_boxes_label, QLabel#text_switch_label {
    color: {{text_2}};
    font-size: {{font_base}};
}
QFrame#labelRow {
    background: {{bg_control}};
    border-radius: {{r_md}};
}
QLabel#labelRowName {
    color: {{text}};
    background: transparent;
    font-weight: 600;
}
QLabel#labelRowKind {
    color: {{text_3}};
    background: transparent;
}
QLabel#labelRowInfo {
    color: {{text_3}};
    background: transparent;
    font-size: {{font_sm}};
}

/* ---------------- message_box 自绘弹窗 ---------------- */
/* 规则统一挂 QFrame#msgFrame 前缀(2 ID+2 类型): 后代选择器跨窗口层级,
   弹窗 parent 挂在 ModelDialog 等对话框上时, QDialog#Xxx QPushButton(1 ID+2 类型)
   会污染关闭/确认按钮(如删除模型记录弹窗的 ✕ 变小方块), 必须稳压它 */
QFrame#msgFrame {
    background-color: {{bg_panel}};
    border: 1px solid {{border}};
    border-radius: {{r_2xl}};
}
QFrame#msgFrame QLabel#msgTitle {
    color: {{text}};
    font-size: {{font_lg}};
    font-weight: 600;
}
QFrame#msgFrame QPushButton#msgClose {
    background-color: transparent; color: {{text_3}}; border: none;
    border-radius: {{r_md}}; font-size: {{font_2xl}}; padding: 2px 8px;
}
QFrame#msgFrame QPushButton#msgClose:hover { background-color: {{bg_hover}}; color: {{text}}; }
/* border 不能是 none: 它参与高度, 省了会比同排按钮矮 2px, 与 primary 对不齐 */
QFrame#msgFrame QPushButton#msgBtn {
    background-color: {{bg_control_2}}; color: {{text}};
    border: 1px solid transparent;
    border-radius: {{r_md}}; padding: 6px 18px; font-size: {{font_base}};
}
QFrame#msgFrame QPushButton#msgBtn:hover { background-color: {{bg_hover}}; }
QFrame#msgFrame QPushButton#msgBtn:pressed { background-color: {{bg_pressed_2}}; }
/* primary 必须再带一层 QFrame#msgFrame 前缀: 上面两条是双 ID 选择器, 通用段那套
   QPushButton#msgBtn[class~="primary"] 只挂一个 ID, 特异性不够, 主按钮会静默变灰.
   border 不能省: 它参与高度, 省了就比同排按钮矮 2px */
QFrame#msgFrame QPushButton#msgBtn[class~="primary"] {
    background-color: {{accent}}; color: {{text_strong}}; border: 1px solid {{accent}};
    font-weight: bold;
}
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:hover {
    background-color: {{accent_hover}}; border-color: {{accent_hover}};
}
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:pressed {
    background-color: {{accent_pressed}}; border-color: {{accent_pressed}};
}
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:disabled {
    background-color: {{accent_dim}}; border-color: {{accent_dim}}; color: {{text_3}};
}
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:focus,
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:hover:focus {
    border-color: {{text_strong}};
}
QFrame#msgFrame QLabel#msgText {
    color: {{text_2}}; font-size: {{font_base}}; background: transparent;
}
/* 通用段的 QPushButton[class~="danger"] 只有一个属性选择器, 特异性低于
   上面的双 ID 规则, 不在这里重复一份弹窗里还是普通灰按钮 */
QFrame#msgFrame QPushButton#msgBtn[class~="danger"] {
    background-color: {{danger_bg}}; border: 1px solid {{danger_border}}; color: {{danger_text}};
}
QFrame#msgFrame QPushButton#msgBtn[class~="danger"]:hover {
    background-color: {{danger_bg_hover}}; border-color: {{danger_border_hover}};
}
QFrame#msgFrame QPushButton#msgBtn[class~="danger"]:pressed {
    background-color: {{danger_bg_pressed}}; border-color: {{danger_border_hover}};
}
QFrame#msgFrame QPushButton#msgBtn[class~="danger"]:disabled {
    background-color: {{bg_panel}}; border-color: {{border_subtle}}; color: {{text_disabled}};
}
/* 报错详情: 等宽 + 可选中, 长行横向滚动而不是把窗口撑宽 */
QFrame#msgFrame QPlainTextEdit#msgDetail {
    background-color: {{bg_sunken}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_md}};
    color: {{text_2}};
    font-family: Consolas, "Cascadia Mono", "Courier New", monospace;
    font-size: {{font_md}};
    padding: 6px 8px;
    selection-background-color: {{accent}};
}
/* 路径清单块: 标题 + 复制 + 带警示色点的条目(失效目录/失效图像这类多项提示) */
QFrame#msgFrame QFrame#msgList {
    background-color: {{bg_sunken}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_md}};
}
QFrame#msgFrame QLabel#msgListTitle {
    color: {{text_3}}; font-size: {{font_sm}}; background: transparent;
}
QFrame#msgFrame QPushButton#msgListCopy {
    background: transparent; border: none; padding: 0 2px;
    color: {{accent_soft}}; font-size: {{font_sm}};
}
QFrame#msgFrame QPushButton#msgListCopy:hover { color: {{accent_hover}}; }
QFrame#msgFrame QLabel#msgListDot {
    background-color: {{icon_warning}}; border-radius: {{r_sm}};
}
QFrame#msgFrame QLabel#msgListItem {
    color: {{text_2}}; font-size: {{font_md}}; background: transparent;
}
QFrame#msgFrame QLabel#msgListMore {
    color: {{text_3}}; font-size: {{font_sm}}; background: transparent;
}

/* ---------------- ProgressDialog ---------------- */
/* 进度框也走 message_box 的无边框外壳, 样式挂 msgFrame 前缀, 按钮复用 msgBtn */
QFrame#msgFrame QLabel#progressText { color: {{text}}; font-size: {{font_base}}; }
QFrame#msgFrame QProgressBar#progressBar {
    background: {{bg_control_2}}; border: none; border-radius: {{r_sm}};
    height: 10px; color: transparent;
}
QFrame#msgFrame QProgressBar#progressBar::chunk {
    background: {{accent}}; border-radius: {{r_sm}};
}

/* 标注界面"添加标签"与首页"+"同款 ghost 样式。
   必须放在 #AnnotationDialog QPushButton 之后: 两者特异性相同, 靠后者胜,
   放前面会被它的 padding:6px 14px 把加号挤出 24px 方块 */
QPushButton#add_label {
    background: transparent;
    border: 1px solid {{border}};
    border-radius: {{r_md}};
    padding: 0;
    min-height: 0;
    color: {{text_3}};
    font-size: {{font_xl}};
}
QPushButton#add_label:hover {
    color: {{text}};
    border-color: {{border_hover}};
    background-color: {{bg_control}};
}

/* ---------------- 模型权重对话框 ---------------- */
QLabel[class~="modelGroupTitle"] {
    color: {{text_3}};
    font-size: {{font_md}};
    padding-left: 2px;
}

QFrame[class~="modelGroup"] {
    background-color: {{bg_raised}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
}

QFrame#modelRow {
    border: none;
    border-bottom: 1px solid {{border_subtle}};
    background: transparent;
}

/* 最后一行不画分隔线, 否则和分组框下边框叠成粗线 */
QFrame#modelRow[last="true"] {
    border-bottom: none;
}

QLabel[class~="modelName"] { color: {{text}}; }
QLabel[class~="modelSize"] { color: {{text_3}}; }
QLabel[class~="modelDesc"] { color: {{text_3}}; }
QLabel[class~="modelStatus"] { color: {{text_3}}; }
QLabel[class~="modelStatus"][state="busy"] { color: {{accent}}; }
QLabel[class~="modelStatus"][state="ready"] { color: {{st_ok}}; }
QLabel[class~="modelStatus"][state="failed"] { color: {{st_err}}; }
QLabel[class~="modelStatus"][state="local"] { color: {{st_info}}; }
QLabel[class~="modelStatus"][state="broken"] { color: {{st_err}}; }

/* 行首色点: 状态不只靠右端那行字, 扫视时先看到颜色 */
QLabel[class~="modelDot"] {
    border-radius: 4px;
    background-color: {{text_disabled}};
}
QLabel[class~="modelDot"][state="ready"] { background-color: {{st_ok}}; }
QLabel[class~="modelDot"][state="busy"] { background-color: {{accent}}; }
QLabel[class~="modelDot"][state="local"] { background-color: {{st_info}}; }
QLabel[class~="modelDot"][state="broken"] { background-color: {{st_err}}; }
QLabel[class~="modelDot"][state="failed"] { background-color: {{st_err}}; }

QFrame#modelRow:hover { background-color: {{hover_chip}}; }

QProgressBar#modelProgress {
    background-color: {{bg_sunken}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_lg}};
    text-align: center;
    color: {{text_strong}};
    font-size: {{font_sm}};
    min-height: 0px;
    max-height: 14px;
}

QProgressBar#modelProgress::chunk {
    border-radius: {{r_md}};
}

QLabel[class~="modelFootLabel"] {
    color: {{text_3}};
    font-size: {{font_md}};
}

QLabel[class~="modelDir"] {
    color: {{text_2}};
    font-size: {{font_md}};
}

QLabel[class~="modelLocalPath"] {
    color: {{text_3}};
    font-size: {{font_md}};
}

QPushButton[class~="modelLocal"] {
    background-color: transparent;
    border: 1px solid {{border}};
    border-radius: {{r_md}};
    padding: 0px;
    min-height: 22px;
    color: {{text_3}};
    font-size: {{font_md}};
}

QPushButton[class~="modelLocal"]:hover {
    background-color: {{bg_hover}};
    border-color: {{border_hover}};
    color: {{text}};
}

QDialog#ModelManagerDialog QPushButton#start_btn {
    min-width: 96px;
}

/* ---------------- 底栏分页 ---------------- */
/* 翻页做成 28x28 纯图标按钮: "上一页"三个汉字配全局 QPushButton 的
   padding(6px 14px), 单个约 78px, 而底栏里只有这俩按钮, 比例失衡.
   ID 选择器特异性高于类型选择器, hover/pressed/disabled 必须一起写,
   否则全局那几条会被顶掉(add_project_btn 上踩过这个坑).
   尺寸只在 .ui 里用 min=max 定, 这里别写 min-width —— QSS 的 min-width
   会覆盖 widget 的 minimumSize, 把 28 压回 sizeHint(20). */
QPushButton#pre_page_btn, QPushButton#next_page_btn {
    padding: 0;
}

/* 标注对话框底栏是同名的文字按钮, 不能跟着清内边距(会比同界面按钮矮 12px) */
#AnnotationDialog QPushButton#pre_page_btn,
#AnnotationDialog QPushButton#next_page_btn {
    padding: {{pad_btn}};
}

QPushButton#pre_page_btn:hover, QPushButton#next_page_btn:hover {
    background-color: {{bg_hover}};
    border-color: {{border_hover}};
}

QPushButton#pre_page_btn:pressed, QPushButton#next_page_btn:pressed {
    background-color: {{bg_pressed}};
}

QPushButton#pre_page_btn:disabled, QPushButton#next_page_btn:disabled {
    background-color: {{bg_panel}};
    border-color: {{border_subtle}};
}

/* 页码夹在两个箭头中间当视觉中心, 当前页数字化亮见 _set_page_info */
#pageInfoLabel {
    color: {{text_3}};
    padding: 0 12px;
}

/* ================ 迁移自 Python 的内联样式 ================
 * 这些规则原先以 setStyleSheet 字符串写在各 .py 里。搬来此处有两个好处：
 * ①配色不再散落在代码里；②原先只在控件构造时替换一次令牌，界面倍率变化后
 * 用的还是旧值，放到这里会随 style.qss 一起重新加载。
 * 选择器都已用对象名限定，不会外溢到别的界面。
 * 特异性注意：落在 #ModelDialog / #AnnotationDialog 里的控件必须带对话框 ID
 * 前缀（凑够 2 个 ID），否则盖不住那两段「1 ID + 2 类型」的通用按钮规则。 */

/* --- 模型详情：可折叠长文本块（app/widgets/collapsible_text.py） --- */
CollapsibleText { font-size: {{font_md}}; }
#foldBody {
    background-color: {{bg_sunken}};
    border: 1px solid {{border_subtle}};
    border-radius: {{r_sm}};
    padding: 3px 5px;
    color: {{text_2}};
}
#foldBody:focus { border: 1px solid {{border_subtle}}; }

/* --- 对比多次训练：指标切换 tab（app/widgets/metric_tabs.py） --- */
#metricTabsBox {
    background-color: {{bg_control}};
    border: 1px solid {{border}};
    border-radius: 7px;
}
#metricTabsBox QScrollArea, #metricTabsBox QWidget#metricTabsInner {
    background: transparent;
    border: none;
}
#metricTabsBox QToolButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 5px 12px;
    color: {{text_3}};
}
#metricTabsBox QToolButton:hover:!disabled {
    background-color: {{bg_hover}};
    color: {{text}};
}
#metricTabsBox QToolButton:checked {
    background-color: {{accent}};
    color: {{text_strong}};
}
#metricTabsBox QToolButton:disabled { color: {{text_disabled}}; }

/* --- 对比多次训练：右栏 最佳记录 / 参数差异 / 结论（app/widgets/compare_diff.py） --- */
#diffCard {
    background-color: {{bg_control}};
    border: 1px solid {{border_strong}};
    border-radius: 8px;
}
#diffCardTitle { color: {{text_2}}; font-weight: 600; }
#diffCardHint { color: {{text_faint}}; font-weight: 400; }
#diffBestName { color: {{text_strong}}; font-weight: 600; }
#diffBestMeta { color: {{text_3}}; }
#diffKeyValue { color: {{text_2}}; }
#diffKeyTime { color: {{text_faint}}; }
#diffCommon { color: {{text_3}}; }
#diffConcl { color: {{text_2}}; }

/* --- 弱化说明文字：原 compare_dialog._muted / metrics_dialog._muted_style --- */
#metric_caption, #range_caption,
#chart_title_label, #table_title_label,
#metricsFilterLabel, #metricsTipLabel { color: {{text_3}}; font-size: {{font_base}}; }
#records_caption, #diff_caption, #hint_label,
#source_label, #status_legend_label { color: {{text_3}}; font-size: {{font_md}}; }
#legend_label, #selected_count_label { color: {{text_3}}; font-size: {{font_sm}}; }

/* --- 模型管理：表格单元格容器（app/widgets/model_dialog.py）
 * 全局 QWidget 背景会把容器刷成整块深色，用 id 只对容器本身透明 --- */
#cellWrap { background: transparent; }

/* --- 模型管理：行内 测试 / 导出(opsGo) 与 删除(opsDel) --- */
QDialog#ModelDialog QPushButton#opsGo {
    background-color: {{ok_bg}}; border: 1px solid {{ok_border}}; color: {{ok_text}};
    border-radius: {{r_md}}; padding: 2px 6px; font-size: {{font_md}};
}
QDialog#ModelDialog QPushButton#opsGo:hover {
    background-color: {{ok_bg_hover}}; border-color: {{ok_border_hover}};
}
QDialog#ModelDialog QPushButton#opsGo:pressed { background-color: {{ok_bg_pressed}}; }
QDialog#ModelDialog QPushButton#opsGo:disabled {
    background-color: {{bg_panel}}; border-color: {{border_subtle}}; color: {{text_disabled}};
}
QDialog#ModelDialog QPushButton#opsDel {
    background-color: {{danger_bg}}; border: 1px solid {{danger_border}}; color: {{danger_text}};
    border-radius: {{r_md}}; padding: 2px 6px; font-size: {{font_md}};
}
QDialog#ModelDialog QPushButton#opsDel:hover {
    background-color: {{danger_bg_hover}}; border-color: {{danger_border_hover}};
}
QDialog#ModelDialog QPushButton#opsDel:pressed { background-color: {{danger_bg_pressed}}; }
QDialog#ModelDialog QPushButton#opsDel:disabled {
    background-color: {{bg_panel}}; border-color: {{border_subtle}}; color: {{text_disabled}};
}

/* --- 标注对话框：剪切板缩略图（app/annotation/annotation_canvas.py）
 * 底色是标注子主题专用色，暂未令牌化，保持原值 --- */
#AnnotationDialog QPushButton#clipThumb {
    border: 2px solid {{border_strong}};
    border-radius: {{r_sm}};
    padding: 0px;
    background: #22252d;
    min-width: {{clip_w}}; max-width: {{clip_w}};
    min-height: {{clip_h}}; max-height: {{clip_h}};
}
#AnnotationDialog QPushButton#clipThumb:hover { border-color: {{accent_hover}}; }
#AnnotationDialog QPushButton#clipThumb:checked {
    border-color: {{accent}};
    background: #1d2735;
}
