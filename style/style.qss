/* ============================================================
   现代深色主题
   色阶：新增样式请先复用，不要自造相近色（历史上有过 #3a3f4e/#3a3f4d
   只差 1 的两套边框色，肉眼无差别但会越积越多）
     底色 #181a20  面板 #1c1e25  表头 #1f2129
     控件 #23262f  次级控件 #2a2e38  分隔线 #2c303c
     主色 #4f7dff (hover #638cff / pressed #3f6ceb)
     正文 #e8eaf0  次要 #c3c9d6  弱化 #8b93a5
   标注对话框是独立子主题（底色 #13151a），有意比全局更暗
   ============================================================ */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #e8eaf0;
    outline: none;
}

QWidget {
    background-color: #181a20;
    color: #e8eaf0;
}

/* ---------------- 主窗口 / 对话框 ---------------- */
QMainWindow, QDialog {
    background-color: #181a20;
}

/* ---------------- 顶部标题栏 ---------------- */
QFrame#headerBar {
    background-color: #1f2129;
    border-bottom: 1px solid #2c303c;
}

QLabel#appTitle {
    font-size: 17px;
    font-weight: bold;
    color: #ffffff;
}

/* ---------------- 侧边栏 ---------------- */
QFrame#sidebarPanel {
    background-color: #1a1c23;
    border-right: 1px solid #2c303c;
}

QLabel#sidebarTitle {
    color: #6c7385;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 2px 0 4px 2px;
}

/* 侧栏「+」ghost 小按钮（24x24, 覆盖全局 padding 避免文字被挤出） */
QPushButton#add_project_btn {
    background: transparent;
    border: 1px solid #353a48;
    border-radius: 6px;
    padding: 0;
    min-height: 0;
    color: #8b93a5;
    font-size: 15px;
}
QPushButton#add_project_btn:hover {
    color: #e8eaf0;
    border-color: #4a5164;
    background-color: #23262f;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background-color: #23262f;
    border: 1px solid #353a48;
    border-radius: 6px;
    padding: 6px 14px;
    color: #e8eaf0;
    min-height: 20px;
}

/* 弹窗内按钮统一 36 高（内容 22 + padding 12 + 边框 2），与输入框同高 */
QDialog QPushButton {
    min-height: 22px;
}

/* 纯图标按钮(确定/取消)尺寸由 dialog_buttons.setFixedSize(56,36) 决定，
   min-height 22 的样式约束会和它打架顶到 38，这里压回 20 豁免 */
QPushButton[class~="iconBtn"] {
    min-height: 20px;
}

QPushButton:hover {
    background-color: #2b2f3b;
    border-color: #454b5e;
}

QPushButton:pressed {
    background-color: #1d2027;
}

QPushButton:disabled {
    background-color: #1c1e25;
    border-color: #2a2d37;
    color: #5c6270;
}

/* #msgBtn 是 ID 选择器，特异性高于属性选择器，弹窗按钮要带 ID 才盖得住 */
QPushButton[class~="primary"],
QPushButton#msgBtn[class~="primary"] {
    background-color: #4f7dff;
    border: 1px solid #4f7dff;
    color: #ffffff;
    font-weight: bold;
}

QPushButton[class~="primary"]:hover,
QPushButton#msgBtn[class~="primary"]:hover {
    background-color: #638cff;
    border-color: #638cff;
}

QPushButton[class~="primary"]:pressed,
QPushButton#msgBtn[class~="primary"]:pressed {
    background-color: #3f6ceb;
}

QPushButton[class~="primary"]:disabled,
QPushButton#msgBtn[class~="primary"]:disabled {
    background-color: #2c3a5e;
    border-color: #2c3a5e;
    color: #7d879c;
}

QPushButton[class="danger"] {
    background-color: #3a2329;
    border: 1px solid #6e3a42;
    color: #ff9aa2;
}

QPushButton[class="danger"]:hover {
    background-color: #4d2a32;
    border-color: #a04a55;
}

QPushButton[class="ghost"] {
    background-color: transparent;
    border: 1px solid #3a3f4e;
    color: #c3c9d6;
}

QPushButton[class="ghost"]:hover {
    background-color: #23262f;
    border-color: #4a5164;
}

/* 工具栏按钮 */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px;
    color: #c3c9d6;
}

QToolButton:hover {
    background-color: #262a35;
}

QToolButton:checked {
    background-color: #2c3a5e;
}

/* ---------------- 输入框 ---------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #181a20;
    border: 1px solid #333845;
    border-radius: 6px;
    padding: 5px 10px;
    selection-background-color: #4f7dff;
    selection-color: #ffffff;
}

/* 弹窗内输入类控件统一 36 高（内容 24 + padding 10 + 边框 2），
   与按钮同高；min-height 只算内容区，主界面不受影响 */
QDialog QLineEdit, QDialog QComboBox, QDialog QSpinBox, QDialog QDoubleSpinBox {
    min-height: 24px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #4f7dff;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #1c1e25;
    color: #5c6270;
}

/* ---------------- 下拉框 ---------------- */
QComboBox {
    background-color: #181a20;
    border: 1px solid #333845;
    border-radius: 6px;
    padding: 5px 10px;
}

QComboBox:hover {
    border-color: #454b5e;
}

QComboBox:focus {
    border-color: #4f7dff;
}

/* 语言下拉要装九种语言名里最长的那个(Tiếng Việt), 左右内边距比通用下拉紧一点 */
#language_comboBox {
    padding: 5px 6px;
}

/* 箭头区默认占 24px, 而箭头图只用 11px + 8px 右边距, 富余的宽度让给文字区:
   控件因此能从 134 收到 130, 最长那条(Tiếng Việt)右边还剩 5px.
   只写 ::drop-down, 别给 ::down-arrow 加 id 规则 —— 不同选择器的规则不合并,
   那样会让全局的箭头图片整条失效. */
#language_comboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* Qt 不认 CSS 的 border 三角写法(会画成实心方块), 箭头只能用图片 */
QComboBox::down-arrow {
    image: url({{RES_DIR}}/arrow_down.svg);
    width: 11px;
    height: 7px;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #20232b;
    border: 1px solid #3a3f4e;
    border-radius: 6px;
    /* 贴合下拉框的一边不画圆角, 由 popupOpen 抹平控件侧后拼成一整块 */
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    selection-background-color: #2c3a5e;
    selection-color: #ffffff;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    border-radius: 4px;
    padding-left: 8px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #2c3a5e;
}

/* 展开时抹平下拉框的下圆角, 与弹层拼成一整块(标记由 widgets/popup_flat.py 打上).
   选择器要覆盖各处单独定义过 border-radius 的下拉框 */
QComboBox[popupOpen="true"],
#label_comboBox[popupOpen="true"],
QDialog#MoveTargetDialog QComboBox[popupOpen="true"] {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QHeaderView::section {
    background-color: #1f2129;
    border: none;
    padding: 6px;
    color: #8b93a5;
}

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3a3f4e;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4a5164;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #3a3f4e;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #4a5164;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------------- 进度条 ---------------- */
QProgressBar {
    background-color: #10131a;
    border: 1px solid #2e323e;
    border-radius: 8px;
    text-align: center;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f7dff, stop:1 #7ba2ff);
    border-radius: 7px;
}

/* ---------------- 剩余时间 / 显存（训练时显示） ---------------- */
QTimeEdit#time_count_edit {
    background-color: #10131a;
    border: 1px solid #2e323e;
    border-radius: 6px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    min-height: 18px;
    selection-background-color: #4f7dff;
}

QTimeEdit#time_count_edit:focus {
    border-color: #4f7dff;
}

QLabel#time_count_label, QLabel#gpu_memory_label {
    color: #8b93a5;
    font-size: 12px;
    background: transparent;
    padding: 0 2px;
}

/* ---------------- 标签 ---------------- */
QLabel {
    background: transparent;
}

/* ---------------- 选项卡 ---------------- */
QTabWidget::pane {
    border: none;
    background-color: #14151a;
}

QTabBar::tab {
    background: transparent;
    color: #8b93a5;
    border: none;
    padding: 8px 22px;
    font-size: 14px;
    font-weight: bold;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #4f7dff;
}

QTabBar::tab:hover:!selected {
    color: #c3c9d6;
}

/* ---------------- 分组框 ---------------- */
QGroupBox {
    background-color: #1c1e25;
    border: 1px solid #2c303c;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #c3c9d6;
}

/* ---------------- 列表 ---------------- */
QListWidget {
    background-color: #181a20;
    border: 1px solid #333845;
    border-radius: 8px;
    outline: none;
}

QListWidget::item {
    padding: 2px 4px;
    border-radius: 5px;
    margin: 1px 3px;
}

QListWidget::item:hover {
    background-color: #23262f;
}

QListWidget::item:selected {
    background-color: #2c3a5e;
    color: #ffffff;
}

/* ---------------- 表格 ---------------- */
QTableWidget, QTableView {
    background-color: #181a20;
    border: 1px solid #333845;
    border-radius: 8px;
    gridline-color: #2c303c;
    alternate-background-color: #1c1e25;
}

QTableWidget::item, QTableView::item {
    padding: 5px;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #2c3a5e;
    color: #ffffff;
}

QTableCornerButton::section {
    background-color: #1f2129;
    border: none;
}

/* ---------------- 单选 / 复选 ---------------- */
QRadioButton, QCheckBox {
    spacing: 12px;
    color: #e8eaf0;
    /* Qt 在 QCheckBox/QFormLayout 等场景会把 ::indicator 的 background-color
       当作 widget 的 background 涂到整行（见 test_dialog 复现），
       显式置 transparent 让背景跟随父 widget */
    background-color: transparent;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #454b5e;
    border-radius: 3px;
    background-color: #181a20;
}
QCheckBox::indicator:checked {
    background-color: #4f7dff;
    border-color: #4f7dff;
    /* 勾形是预渲染 PNG(28px 给 14px, 与 radio 同样的 2 倍图):
       QSS 画不出勾, 直接给图在分数缩放下比缩放矢量更可控 */
    image: url({{RES_DIR}}/check_mark.png);
}
QCheckBox::indicator:hover {
    border-color: #4f7dff;
}

/* 单选指示器用预渲染 PNG(QPainter 反锯齿正圆):
   QSS border-radius 在小尺寸+分数缩放(125%/150%)下会画成圆角方块 */
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: none;
    background-color: transparent;
    image: url({{RES_DIR}}/radio_off.png);
}
QRadioButton::indicator:hover {
    image: url({{RES_DIR}}/radio_off_hover.png);
}
QRadioButton::indicator:checked {
    image: url({{RES_DIR}}/radio_on.png);
}

/* ---------------- 分割条 ---------------- */
QSplitter::handle {
    background-color: #2c303c;
}

QSplitter::handle:horizontal {
    width: 1px;
}

/* ---------------- 提示气泡 ---------------- */
QToolTip {
    background-color: #262a35;
    color: #e8eaf0;
    border: 1px solid #454b5e;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ---------------- 滑条 ---------------- */
QSlider::groove:horizontal {
    height: 6px;
    background: #39404f;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
    background: #4f7dff;
}
QSlider::handle:horizontal:hover { background: #638cff; }

QSlider::sub-page:horizontal {
    background: #4f7dff;
    border-radius: 3px;
}

/* ---------------- 键盘焦点 ---------------- */
/* 顶部 * 关掉了 outline，Tab 必须补回。
   按钮不能用 outline：Qt 把它画在 SE_PushButtonFocusRect 上，
   那个矩形是内容区（文字一圈），看起来像文字被框住而不是按钮被选中；
   改用 border-color，按钮本来就有 1px 边框，只换颜色不会让文字位移。
   列表/滑条用 outline：focus rect 覆盖整个控件。
   表格不用 outline：Qt 会把 focus rect 画在 current cell 周围，
   看起来像单元格外多一圈蓝框；用 selection 颜色变化已足够表达焦点。 */
QCheckBox:focus, QRadioButton:focus {
    /* 单选/复选不能用 outline: Qt 画在文字一圈, 点击后也会带框;
       焦点改由指示器边框变蓝表达, 键盘导航仍可见 */
    outline: none;
}
QCheckBox:focus::indicator {
    border-color: #4f7dff;
}
QListWidget:focus, QTreeWidget:focus,
QSlider:focus {
    outline: 2px solid #4f7dff;
    outline-offset: 1px;
}
QTableWidget:focus, QTableView:focus {
    outline: none;
    selection-background-color: #2c3a5e;
}
QTableWidget::item:focus, QTableView::item:focus {
    border: none;
    outline: none;
}
/* 点完按钮鼠标通常还在上面，hover 特异性更高会盖掉 :focus，必须并列写 */
QPushButton:focus, QPushButton:hover:focus {
    border-color: #4f7dff;
}
/* 工具栏按钮常态无边框，用背景提示焦点，避免加边框导致图标位移 */
QToolButton:focus, QToolButton:hover:focus {
    background-color: #2b2f3b;
}
/* Primary/Danger 背景本身接近主色，边框换成对比色才看得出 */
QPushButton[class~="primary"]:focus,
QPushButton[class~="primary"]:hover:focus,
QPushButton#msgBtn[class~="primary"]:focus,
QPushButton#msgBtn[class~="primary"]:hover:focus {
    border-color: #ffffff;
}
QPushButton[class="danger"]:focus,
QPushButton[class="danger"]:hover:focus {
    border-color: #ff9aa2;
}

/* ---------------- 项目侧边栏（卡片式，行内容由 delegate 手绘） ---------------- */
QWidget#projectSidebar {
    background: transparent;
}
QFrame#projectCard {
    background-color: #20232b;
    border: 1px solid #292d38;
    border-radius: 10px;
}
/* 侧栏数据集列表: 背景与卡片同色(全局 QListWidget 是深底 #181a20);
   item 的背景/边距全部归零, hover/选中态由 DatasetRowDelegate 手绘, 避免叠加 */
QListWidget#datasetList {
    background-color: #20232b;
    border: none;
    outline: none;
}
QListWidget#datasetList::item {
    background: transparent;
    padding: 0;
    margin: 0;
    border-radius: 0;
}
QListWidget#datasetList::item:hover,
QListWidget#datasetList::item:selected {
    background: transparent;
}
QFrame#sidebarStatsLine {
    background-color: #242832;
    border: none;
}
QLabel#sidebarStats {
    color: #5a6273;
    font-size: 11px;
    background: transparent;
}

/* ---------------- 数据集对话框（ui/add_dataset） ---------------- */
QDialog#AddDatasets {
    background-color: #1c1e25;
}
QPushButton#done_btn {
    background-color: #4f7dff;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
}
QPushButton#done_btn:hover {
    background-color: #638cff;
}
QPushButton#done_btn:pressed {
    background-color: #3f6ceb;
}

/* ================ 标注对话框（AnnotationDialog） ================
 * 原 ANNOTATION_QSS（app/annotation_dialog.py 内嵌字符串）迁移至此。
 * 全部用 #AnnotationDialog 作用域限定：只作用于标注对话框及其后代，
 * 不污染主窗口 / 其他弹窗（对象名在 AnnotationDialog.__init__ 设置）。 */
#AnnotationDialog {
    background-color: #13151a;
    color: #e8eaf0;
}
#AnnotationDialog QWidget {
    background-color: #13151a;
    color: #e8eaf0;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC";
    font-size: 13px;
}
#AnnotationDialog QLabel {
    background: transparent;
    color: #e8eaf0;
}
#AnnotationDialog QLineEdit {
    background-color: #1d2028;
    border: 1px solid #3a3f4e;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e8eaf0;
    selection-background-color: #2c3a5e;
}
/* 工具栏输入框高度锁成和按钮一致: QSS 尺寸按内容盒算(22+padding12+边框2=36,
   与 QPushButton 的 min-height:22 同一套盒模型), 代码里不再 setFixedSize 高度 */
#AnnotationDialog QLineEdit#min_ange_lineEdit,
#AnnotationDialog QLineEdit#max_ange_lineEdit,
#AnnotationDialog QLineEdit#blend_strength_lineEdit {
    min-height: 22px;
    max-height: 22px;
}
/* 填充值 RGB 三框: 锁成 36x36 正方形(高 22+6*2+2, 宽 26+4*2+2);
   横向 padding 不能用 10px, 否则内容区太窄 "255" 三位数显示不下 */
#AnnotationDialog QLineEdit#fill_r_lineEdit,
#AnnotationDialog QLineEdit#fill_g_lineEdit,
#AnnotationDialog QLineEdit#fill_b_lineEdit {
    min-height: 22px;
    max-height: 22px;
    min-width: 26px;
    max-width: 26px;
    padding: 6px 4px;
}
#AnnotationDialog QPushButton {
    background-color: #2a2e3a;
    border: 1px solid #3a3f4e;
    border-radius: 6px;
    padding: 6px 14px;
    color: #cfd6e4;
}
#AnnotationDialog QPushButton:hover {
    background-color: #333948;
    border-color: #4f7dff;
}
#AnnotationDialog QPushButton:pressed {
    background-color: #242834;
}
#AnnotationDialog QPushButton[drawActive="true"] {
    background-color: #2c3a5e;
    color: #ffffff;
    border: 1px solid #4f7dff;
}
/* ---------- 标注参数弹层 ----------
   特异性必须高于上面的 `#AnnotationDialog QWidget`(底色 #13151a), 否则浮层和画布同色,
   看起来就是一块没有边框的空白. */
#AnnotationDialog QFrame#paramsPanel {
    background-color: #1c1e25;
    border: 1px solid #3a4152;
    border-radius: 10px;
}
#AnnotationDialog QLabel#params_title {
    color: #8b93a5;
    font-size: 12px;
}
#AnnotationDialog QFrame#paramsPanel QLabel {
    color: #c3c9d6;
}
#AnnotationDialog QFrame#params_sep {
    background-color: #2c303c;
    border: none;
}
/* 弹层里的输入框比工具条矮一档(工具条 36, 这里 16+6*2+2=30) */
#AnnotationDialog QFrame#paramsPanel QLineEdit {
    min-height: 16px;
    max-height: 16px;
}
#AnnotationDialog QPushButton#fill_color_btn {
    padding: 0;
    border: 1px solid #4a5164;
    border-radius: 6px;
}
/* 与同行色块同尺寸(28x28 = 内容盒 26 + 边框 2). 尺寸必须写进按钮自身的 QSS:
   全局 QPushButton 的 min-height 内边距会架空 setFixedSize 的下限 */
#AnnotationDialog QPushButton#custom_color_btn {
    padding: 0;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    border: 1px solid #4a5164;
    border-radius: 6px;
    background-color: #2a2e3a;
}
#AnnotationDialog QPushButton#custom_color_btn:hover {
    border-color: #4f7dff;
    background-color: #333846;
}
/* 滑块会被上面的 `#AnnotationDialog QWidget`(底色 #13151a) 刷成比弹层底
   (#1c1e25) 更黑的一条, 这里只保留中间的 groove */
#AnnotationDialog QFrame#paramsPanel QSlider {
    background: transparent;
}
#AnnotationDialog QPushButton#reset_params_btn,
#AnnotationDialog QPushButton#close_params_btn {
    min-width: 72px;
}
#AnnotationDialog QScrollArea {
    background-color: #1d2028;
    border: 1px solid #3a3f4e;
    border-radius: 6px;
}
#AnnotationDialog QScrollArea > QWidget > QWidget {
    background-color: #1d2028;
}
#AnnotationDialog QScrollBar:vertical {
    background: #1d2028;
    width: 8px;
    border: none;
}
#AnnotationDialog QScrollBar::handle:vertical {
    background: #3a3f4e;
    border-radius: 4px;
    min-height: 24px;
}
#AnnotationDialog QScrollBar::handle:vertical:hover { background: #4f7dff; }
#AnnotationDialog QScrollBar::add-line:vertical,
#AnnotationDialog QScrollBar::sub-line:vertical { height: 0; }

/* ---------------- 菜单 ---------------- */
/* 这段必须排在 `#AnnotationDialog QWidget`(见上) 之后: 两者的特异性都是 1 个 id + 1 个类型,
   平手时按出现顺序决胜, 排在前面的话菜单底色会被那条刷掉 */
QMenu,
#AnnotationDialog QMenu {
    background-color: #1b1e25;
    border: 1px solid #3a3f4e;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item,
#AnnotationDialog QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected,
#AnnotationDialog QMenu::item:selected {
    background-color: #33405e;
    color: #ffffff;
}

/* QSS 下禁用项默认沿用正常文字色, 不设就分不出能不能点 */
QMenu::item:disabled,
#AnnotationDialog QMenu::item:disabled {
    color: #6a7080;
}

QMenu::separator,
#AnnotationDialog QMenu::separator {
    height: 1px;
    background: #2e3340;
    margin: 4px 8px;
}

/* ================ 训练对话框 ================ */
QDialog#TrainDialog,
QDialog#TrainQueueDialog { background-color: #1c1e25; }

/* 队列面板:状态徽标跟随队列状态变色 */
QDialog#TrainQueueDialog QLabel#queue_badge { color: #8b93a5; }

/* 面板内控件比对话框底亮一档(#1c1e25 → #2a2e38)，聚焦只换边框色不改变盒子尺寸 */
QDialog#TrainDialog QLineEdit,
QDialog#TrainDialog QComboBox {
    background-color: #2a2e38;
    border: 1px solid transparent;
}
QDialog#TrainDialog QLineEdit:hover,
QDialog#TrainDialog QComboBox:hover { border-color: #454b5e; }
QDialog#TrainDialog QLineEdit:focus,
QDialog#TrainDialog QComboBox:focus { border-color: #4f7dff; }
QDialog#TrainDialog QComboBox QAbstractItemView {
    background-color: #23262f;
    border-color: #3a3f4e;
}
QDialog#TrainDialog QPushButton#select_output_path_btn { min-width: 90px; }
QDialog#TrainDialog QPushButton#start_train {
    background-color: #4f7dff;
    color: #ffffff;
    font-weight: 500;
    min-width: 120px;
    padding: 6px 22px;
}
QDialog#TrainDialog QPushButton#start_train:hover { background-color: #638cff; }
QDialog#TrainDialog QPushButton#start_train:pressed { background-color: #3f6ceb; }
QDialog#TrainDialog QPushButton#start_train:disabled {
    background-color: #2a2e38;
    color: #6b7280;
}

/* ---------------- 测试参数对话框 ---------------- */
QDialog#TestDialog { background-color: #1c1e25; }
QDialog#TestDialog QComboBox,
QDialog#TestDialog QLineEdit {
    background-color: #2a2e38;
    border: 1px solid transparent;
}
QDialog#TestDialog QComboBox:focus,
QDialog#TestDialog QLineEdit:focus { border-color: #4f7dff; }
QDialog#TestDialog QPushButton#start_test_btn {
    background-color: #4f7dff; color: #ffffff; font-weight: 500;
    min-width: 110px; padding: 6px 22px;
}
QDialog#TestDialog QPushButton#start_test_btn:hover {
    background-color: #638cff;
}
QDialog#TestDialog QPushButton#start_test_btn:pressed {
    background-color: #3f6ceb;
}

/* 顶部模型信息卡 */
QDialog#TestDialog QFrame#model_card {
    background-color: #181a20;
    border: 1px solid #2c303c;
    border-radius: 8px;
}
QDialog#TestDialog QLabel[class~="modelName"] {
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
}
QDialog#TestDialog QLabel[class~="modelMeta"] {
    color: #8b93a5;
    font-size: 12px;
}

/* ---------------- 通用弹窗组件（训练 / 测试对话框共用） ----------------
   一律按 class 匹配，不绑具体对话框 ID，两个弹窗改版不用各写一份 */
/* 参数行的原生 QWidget 包裹容器必须透明：全局 QWidget 底色 #181a20
   比弹窗底色 #1c1e25 暗一档，不透明会整行拖出“黑条” */
QDialog#TrainDialog QWidget#section_data_wrap,
QDialog#TrainDialog QWidget#section_hyper_wrap,
QDialog#TrainDialog QWidget#early_wrap,
QDialog#TrainDialog QWidget#lr_wrap,
QDialog#TrainDialog QWidget#img_wrap,
QDialog#TrainDialog QWidget#grad_wrap,
QDialog#TrainDialog QWidget#section_out_wrap,
QDialog#TestDialog QWidget#conf_wrap,
QDialog#TestDialog QWidget#iou_wrap,
QDialog#TestDialog QWidget#out_wrap {
    background-color: transparent;
}
QLabel[class~="dialogTitle"] {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
}
/* 分组标题：比字段名的 13px 大两号，撑起「组 → 字段」的层次 */
QLabel[class~="dialogSectionTitle"] {
    color: #8fb0ff;
    font-size: 15px;
    font-weight: 600;
    margin-top: 2px;
}
QLabel[class~="taskBadge"] {
    background-color: #2c3a5e;
    color: #8fb0ff;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 600;
}
/* 参数说明：比 tooltip 更容易被看到 */
QLabel[class~="fieldNote"] {
    color: #7d879c;
    font-size: 12px;
}

/* 底部概要条 */
QFrame#summary_bar {
    background-color: #181a20;
    border: 1px solid #2c303c;
    border-radius: 8px;
}
QLabel[class~="summaryIcon"] {
    color: #4f7dff;
    font-size: 13px;
    font-weight: bold;
}
QLabel[class~="summaryText"] {
    color: #c3c9d6;
    font-size: 13px;
}
/* 分组标题后 / 底栏上方的细分隔线 */
QFrame[class~="dialogSectionLine"],
QFrame#button_line {
    background-color: #2c303c;
    border: none;
    max-height: 1px;
}
QFrame#button_line { margin-top: 2px; }
QLabel#dialogConfirmPrompt { font-size: 15px; }

/* ---------------- 模型管理对话框 ---------------- */
QDialog#ModelDialog { background-color: #1c1e25; }
QDialog#ModelDialog QTableWidget {
    background-color: #181a20;
    alternate-background-color: #1f222a;
    border: 1px solid #2c303c;
    border-radius: 8px;
    gridline-color: #2c303c;
    color: #e8eaf0;
    font-size: 12px;
}
QDialog#ModelDialog QTableWidget::item { padding: 4px 6px; }
QDialog#ModelDialog QTableWidget::item:hover {
    background-color: #232838;
}
QDialog#ModelDialog QTableWidget::item:selected {
    background-color: #2c3a5e;
    color: #ffffff;
}
QDialog#ModelDialog QHeaderView::section {
    background-color: #23262f;
    color: #c3c9d6;
    border: none;
    border-right: 1px solid #2c303c;
    border-bottom: 1px solid #2c303c;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 500;
}
QDialog#ModelDialog QPushButton {
    background-color: #2a2e38; color: #e8eaf0; border: none;
    border-radius: 6px; padding: 4px 12px; font-size: 12px;
}
QDialog#ModelDialog QPushButton:hover { background-color: #343a48; }
QDialog#ModelDialog QPushButton:disabled {
    background-color: #23262f; color: #5c6270;
}
QDialog#ModelDialog QScrollBar:vertical {
    background: #181a20; width: 10px; border: none;
}
QDialog#ModelDialog QScrollBar::handle:vertical {
    background: #3a3f4e; border-radius: 5px; min-height: 30px;
}
QDialog#ModelDialog QScrollBar::add-line:vertical,
QDialog#ModelDialog QScrollBar::sub-line:vertical { height: 0; }

/* ---------------- 测试结果对话框 ---------------- */
QDialog#TestResultDialog { background-color: #181a20; }
QFrame#card_img_total, QFrame#card_img_ok, QFrame#card_img_fn,
QFrame#card_img_fp, QFrame#card_tp, QFrame#card_fn, QFrame#card_fp,
QFrame#card_precision {
    background-color: #1c1e25;
    border: 1px solid #2c303c;
    border-radius: 8px;
}
QDialog#TestResultDialog QLabel[class~="dimTag"] {
    color: #4f7dff;
    font-size: 12px;
    font-weight: 600;
}
QDialog#TestResultDialog QLabel[class~="dimNote"] {
    color: #8b93a5;
    font-size: 12px;
}
QDialog#TestResultDialog QLabel[class~="cardValue"] {
    color: #ffffff;
    font-size: 22px;
    font-weight: 600;
}
QDialog#TestResultDialog QLabel[class~="cardLabel"] {
    color: #8b93a5;
    font-size: 12px;
}
QDialog#TestResultDialog QLabel[class~="cardRate"] {
    font-size: 12px;
}
QDialog#TestResultDialog QLabel#conclusion_label {
    color: #c3c9d6;
    font-size: 13px;
    background-color: #1c1e25;
    border: 1px solid #2c303c;
    border-radius: 8px;
    padding: 12px 14px;
}
QDialog#TestResultDialog QTableWidget {
    background-color: #181a20;
    alternate-background-color: #1f222a;
    border: 1px solid #2c303c;
    border-radius: 8px;
    gridline-color: #2c303c;
    color: #e8eaf0;
    font-size: 12px;
}
QDialog#TestResultDialog QHeaderView::section {
    background-color: #23262f;
    color: #c3c9d6;
    border: none;
    border-right: 1px solid #2c303c;
    border-bottom: 1px solid #2c303c;
    padding: 6px 8px;
    font-size: 12px;
}

/* ---------------- 日志对话框 ---------------- */
QDialog#LogDialog { background-color: #1c1e25; }
QDialog#LogDialog QTextEdit {
    background-color: #0e0f13;
    border: 1px solid #2c303c;
    border-radius: 8px;
    font-family: "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 12px;
    padding: 8px;
    color: #e8eaf0;
    selection-background-color: #4f7dff;
    selection-color: #ffffff;
}
QDialog#LogDialog QPushButton#clr_log_btn {
    background-color: #2a2e38; color: #e8eaf0; border: none;
    border-radius: 6px; padding: 6px 18px; font-size: 13px;
}
QDialog#LogDialog QPushButton#clr_log_btn:hover { background-color: #343a48; }

/* ---------------- 消息框 ---------------- */
QMessageBox { background-color: #1c1e25; }
QMessageBox QLabel {
    color: #e8eaf0; font-size: 13px; min-width: 280px;
    qproperty-alignment: AlignCenter;
}
QMessageBox QPushButton {
    background-color: #2a2e38; color: #e8eaf0; border: none;
    border-radius: 6px; padding: 6px 18px; font-size: 13px;
}
QMessageBox QPushButton:hover { background-color: #343a48; }
QMessageBox QPushButton:default {
    background-color: #4f7dff; color: #ffffff; font-weight: 600;
}
QMessageBox QPushButton:default:hover { background-color: #638cff; }

/* ---------------- 移动目标数据集对话框 ---------------- */
QDialog#MoveTargetDialog { background-color: #1c1e25; }
QDialog#MoveTargetDialog QLabel { color: #e8eaf0; font-size: 13px; }
QDialog#MoveTargetDialog QComboBox {
    background-color: #2a2e38; color: #e8eaf0; border: none;
    border-radius: 6px; padding: 6px 10px; font-size: 13px;
}
QDialog#MoveTargetDialog QComboBox::drop-down { border: none; }
QDialog#MoveTargetDialog QPushButton {
    background-color: #2a2e38; color: #e8eaf0; border: none;
    border-radius: 6px; padding: 6px 18px; font-size: 13px;
}
QDialog#MoveTargetDialog QPushButton:hover { background-color: #343a48; }

/* ---------------- 首页顶部工具栏分组 ---------------- */
QFrame#headerSeparator {
    background: transparent;
    border: none;
    border-right: 1px solid #2c303c;
    margin: 6px 4px;
    width: 1px;
}

/* 标签筛选下拉: 胶囊化, 与按钮总高一致(32px) */
#label_comboBox {
    background-color: #23262f;
    border: 1px solid #353a48;
    border-radius: 14px;
    min-height: 32px;
    padding: 0 14px;
    color: #e8eaf0;
    font-size: 13px;
}
#label_comboBox:hover {
    border-color: #4a5164;
}
#label_comboBox::drop-down {
    border: none;
    width: 20px;
}
#label_comboBox QAbstractItemView {
    background-color: #23262f;
    border: 1px solid #353a48;
    border-radius: 8px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    selection-background-color: #2c3a5e;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

/* ---------------- 数据集行内迷你进度条（导入/标签合并时显示） ---------------- */
QProgressBar#miniProgressBar {
    background-color: rgba(91,140,255,0.25);
    border: none;
    border-radius: 3px;
    color: #ffffff;
    font-size: 10px;
}
QProgressBar#miniProgressBar::chunk {
    background-color: #4f7dff;
    border-radius: 3px;
}

/* ---------------- 多选下拉框只读 lineEdit（统计/训练界面） ---------------- */
/* 多选下拉: 收起态是一排自绘标签, 内边距收窄给标签让位 */
QComboBox[multiCombo="true"] {
    padding: 4px 8px;
}

QComboBox[multiCombo="true"] QLineEdit#multiComboLineEdit,
QComboBox[multiCombo="true"] QLineEdit#multiComboLineEdit:focus {
    background: transparent;
    border: none;
    padding: 0;
}

/* ---------------- 训练对话框开始按钮(主操作) ---------------- */
QPushButton#start_train {
    background-color: #4f7dff;
    border: 1px solid #4f7dff;
    border-radius: 6px;
    color: #ffffff;
    font-weight: bold;
    padding: 6px 22px;
}
QPushButton#start_train:hover {
    background-color: #638cff;
    border-color: #638cff;
}
QPushButton#start_train:pressed {
    background-color: #3f6ceb;
}
QPushButton#start_train:disabled {
    background-color: #2c3a5e;
    border-color: #2c3a5e;
    color: #7d879c;
}

/* ---------------- 停止训练按钮(红色) ---------------- */
QPushButton#stop_train_btn {
    background-color: #d64545;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 13px;
}
QPushButton#stop_train_btn:hover {
    background-color: #e05555;
}

/* ---------------- 标注对话框标签列表 ---------------- */
QLabel#show_boxes_label {
    color: #cfd6e4;
    font-size: 13px;
}
QFrame#labelRow {
    background: #23262f;
    border-radius: 6px;
}
QLabel#labelRowName {
    color: #e8eaf0;
    background: transparent;
    font-weight: 600;
}
QLabel#labelRowKind {
    color: #8b93a5;
    background: transparent;
}
QLabel#labelRowInfo {
    color: #8b93a5;
    background: transparent;
    font-size: 11px;
}

/* ---------------- message_box 自绘弹窗 ---------------- */
/* 规则统一挂 QFrame#msgFrame 前缀(2 ID+2 类型): 后代选择器跨窗口层级,
   弹窗 parent 挂在 ModelDialog 等对话框上时, QDialog#Xxx QPushButton(1 ID+2 类型)
   会污染关闭/确认按钮(如删除模型记录弹窗的 ✕ 变小方块), 必须稳压它 */
QFrame#msgFrame {
    background-color: #1c1e25;
    border: 1px solid #353a48;
    border-radius: 12px;
}
QFrame#msgFrame QLabel#msgTitle {
    color: #e8eaf0;
    font-size: 14px;
    font-weight: 600;
}
QFrame#msgFrame QPushButton#msgClose {
    background-color: transparent; color: #8b93a5; border: none;
    border-radius: 6px; font-size: 15px; padding: 2px 8px;
}
QFrame#msgFrame QPushButton#msgClose:hover { background-color: #3a3f4e; color: #e8eaf0; }
QFrame#msgFrame QPushButton#msgBtn {
    background-color: #2a2e38; color: #e8eaf0; border: none;
    border-radius: 6px; padding: 6px 18px; font-size: 13px;
}
QFrame#msgFrame QPushButton#msgBtn:hover { background-color: #343a48; }
QFrame#msgFrame QPushButton#msgBtn:pressed { background-color: #3d4556; }
/* primary 必须再带一层 QFrame#msgFrame 前缀: 上面两条是双 ID 选择器, 通用段那套
   QPushButton#msgBtn[class~="primary"] 只挂一个 ID, 特异性不够, 主按钮会静默变灰.
   border 不能省: 它同时决定高度(内容 22 + padding 12 + 边框 2 = 36), 省了会比同排的
   iconBtn 矮 2px */
QFrame#msgFrame QPushButton#msgBtn[class~="primary"] {
    background-color: #4f7dff; color: #ffffff; border: 1px solid #4f7dff;
    font-weight: bold;
}
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:hover {
    background-color: #638cff; border-color: #638cff;
}
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:pressed {
    background-color: #3f6ceb; border-color: #3f6ceb;
}
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:disabled {
    background-color: #2c3a5e; border-color: #2c3a5e; color: #7d879c;
}
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:focus,
QFrame#msgFrame QPushButton#msgBtn[class~="primary"]:hover:focus {
    border-color: #ffffff;
}
QFrame#msgFrame QLabel#msgText {
    color: #cfd6e4; font-size: 13px; background: transparent;
}

/* ---------------- ProgressDialog ---------------- */
/* 同样挂 ID 前缀防通配按钮规则污染(见 message_box 段注释) */
QDialog#ProgressDialog QLabel#progressText { color: #e8eaf0; font-size: 13px; }
QDialog#ProgressDialog QProgressBar#progressBar {
    background: #2a2e38; border: none; border-radius: 4px;
    height: 10px; color: transparent;
}
QDialog#ProgressDialog QProgressBar#progressBar::chunk {
    background: #4f7dff; border-radius: 4px;
}
QDialog#ProgressDialog QPushButton#msgBtn {
    background-color: #2a2e38; color: #e8eaf0; border: none;
    border-radius: 6px; padding: 6px 18px; font-size: 13px;
}
QDialog#ProgressDialog QPushButton#msgBtn:hover { background-color: #343a48; }

/* 标注界面"添加标签"与首页"+"同款 ghost 样式。
   必须放在 #AnnotationDialog QPushButton 之后: 两者特异性相同, 靠后者胜,
   放前面会被它的 padding:6px 14px 把加号挤出 24px 方块 */
QPushButton#add_label {
    background: transparent;
    border: 1px solid #353a48;
    border-radius: 6px;
    padding: 0;
    min-height: 0;
    color: #8b93a5;
    font-size: 15px;
}
QPushButton#add_label:hover {
    color: #e8eaf0;
    border-color: #4a5164;
    background-color: #23262f;
}

/* ---------------- 模型权重对话框 ---------------- */
QLabel[class~="modelGroupTitle"] {
    color: #8b93a5;
    font-size: 12px;
    padding-left: 2px;
}

QFrame[class~="modelGroup"] {
    background-color: #1f222a;
    border: 1px solid #2e323e;
    border-radius: 8px;
}

QFrame#modelRow {
    border: none;
    border-bottom: 1px solid #262a34;
    background: transparent;
}

/* 最后一行不画分隔线, 否则和分组框下边框叠成粗线 */
QFrame#modelRow[last="true"] {
    border-bottom: none;
}

QLabel[class~="modelName"] { color: #e6e9f0; }
QLabel[class~="modelSize"] { color: #7a8194; }
QLabel[class~="modelDesc"] { color: #8b93a5; }
QLabel[class~="modelStatus"] { color: #8b93a5; }
QLabel[class~="modelStatus"][state="busy"] { color: #4f7dff; }
QLabel[class~="modelStatus"][state="ready"] { color: #7be39a; }
QLabel[class~="modelStatus"][state="failed"] { color: #ff6b6b; }

QProgressBar#modelProgress {
    background-color: #10131a;
    border: 1px solid #2e323e;
    border-radius: 7px;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
    min-height: 0px;
    max-height: 14px;
}

QProgressBar#modelProgress::chunk {
    border-radius: 6px;
}

QLabel[class~="modelFootLabel"] {
    color: #8b93a5;
    font-size: 12px;
}

QLabel[class~="modelDir"] {
    color: #b9c0d0;
    font-size: 12px;
}

QDialog#ModelManagerDialog QPushButton#start_btn {
    min-width: 96px;
}

/* ---------------- 底栏分页 ---------------- */
/* 翻页做成 28x28 纯图标按钮: "上一页"三个汉字配全局 QPushButton 的
   padding(6px 14px), 单个约 78px, 而底栏里只有这俩按钮, 比例失衡.
   ID 选择器特异性高于类型选择器, hover/pressed/disabled 必须一起写,
   否则全局那几条会被顶掉(add_project_btn 上踩过这个坑).
   尺寸只在 .ui 里用 min=max 定, 这里别写 min-width —— QSS 的 min-width
   会覆盖 widget 的 minimumSize, 把 28 压回 sizeHint(20). */
QPushButton#pre_page_btn, QPushButton#next_page_btn {
    padding: 0;
}

QPushButton#pre_page_btn:hover, QPushButton#next_page_btn:hover {
    background-color: #2b2f3b;
    border-color: #4a5164;
}

QPushButton#pre_page_btn:pressed, QPushButton#next_page_btn:pressed {
    background-color: #1d2027;
}

QPushButton#pre_page_btn:disabled, QPushButton#next_page_btn:disabled {
    background-color: #1c1e25;
    border-color: #2a2d37;
}

/* 页码夹在两个箭头中间当视觉中心, 当前页数字化亮见 _set_page_info */
#pageInfoLabel {
    color: #8b93a5;
    padding: 0 12px;
}
