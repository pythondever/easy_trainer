<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>installer</AssemblyName>
    <ApplicationIcon>..\..\resources\favicon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>EasyTrainer 安装程序</AssemblyTitle>
    <Product>EasyTrainer</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- 程序本体内嵌：先跑 builder/build.py（编译 pyd 并打 dist/program.zip） -->
    <EmbeddedResource Include="..\..\dist\program.zip"
                      Condition="Exists('..\..\dist\program.zip')"
                      LogicalName="program.zip" />
    <!-- pip 引导脚本：embeddable Python 不带 pip，内置它可免装时也免联网 -->
    <EmbeddedResource Include="..\..\builder\get-pip.py"
                      Condition="Exists('..\..\builder\get-pip.py')"
                      LogicalName="get-pip.py" />
    <!-- 预训练权重清单（C# / installer.sh / build.py 三端共享；改这里即可换源或加国内镜像） -->
    <EmbeddedResource Include="..\..\builder\pretrained-assets.txt"
                      Condition="Exists('..\..\builder\pretrained-assets.txt')"
                      LogicalName="pretrained-assets.txt" />
    <!-- pip 现场安装依赖清单（runtime 组件用），随仓库维护在 builder/ -->
    <EmbeddedResource Include="..\..\builder\requirements-release.txt"
                      Condition="Exists('..\..\builder\requirements-release.txt')"
                      LogicalName="requirements.txt" />
  </ItemGroup>

</Project>
